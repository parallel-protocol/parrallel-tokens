{
  "name": "@parallel/parallel-tokens",
  "version": "1.0.0",
  "description": "Parallel Tokens",
  "license": "MIT",
  "scripts": {
    "ci:coverage": "forge coverage --report lcov --ir-minimum && yarn lcov:clean",
    "coverage": "FOUNDRY_PROFILE=dev forge coverage --ir-minimum --report lcov && lcov --remove lcov.info -o lcov.info \"tests/*\" \"node_modules/*\" && genhtml lcov.info -o coverage",
    "compile": "forge build && hardhat compile",
    "compile:dev": "FOUNDRY_PROFILE=dev forge build",
    "deploy": "npx hardhat deploy",
    "deploy:bridgeableTokenP": "npx hardhat lz:deploy --tags BridgeableTokenP",
    "deploy:fork": "forge script --skip test  --slow --fork-url fork --broadcast -vvvv",
    "generate": "FOUNDRY_PROFILE=dev forge script scripts/utils/GenerateSelectors.s.sol",
    "OApp:wire:mainnet": "npx hardhat lz:oapp:wire --oapp-config layerZero/mainnet/bridgeableTokenP.config.ts",
    "OApp:wire:testnet": "npx hardhat lz:oapp:wire --oapp-config layerZero/testnet/bridgeableTokenP.config.ts",
    "gas": "FOUNDRY_PROFILE=dev bun run test --gas-report",
    "fork": "bash helpers/fork.sh",
    "run": "docker run -it --rm -v $(pwd):/app -w /app ghcr.io/foundry-rs/foundry sh",
    "script:fork": "FOUNDRY_PROFILE=dev forge script --skip test --fork-url fork --broadcast -vvvv",
    "test": "forge test -vvv --gas-report --no-match-path \"tests/invariants/**/*.sol\"",
    "test:invariant": "forge test -vvv --gas-report --match-path \"tests/invariants/**/*.sol\"",
    "lcov:clean": "lcov --remove lcov.info -o lcov.info 'tests/**' 'scripts/**' 'contracts/transmuter/configs/**' 'contracts/utils/**'",
    "lcov:generate-html": "genhtml lcov.info --output=coverage",
    "slither": "slither . --triage-mode",
    "size": "forge build --skip test --sizes",
    "prettier": "prettier --write '**/*.sol'",
    "lint": "bun run lint:check --fix",
    "lint:check": "solhint \"**/*.sol\"",
    "verify": "npx hardhat etherscan-verify --sleep"
  },
  "devDependencies": {
    "@layerzerolabs/lz-definitions": "^3.0.74",
    "@layerzerolabs/test-devtools-evm-foundry": "^6.0.2",
    "@layerzerolabs/toolbox-hardhat": "^0.6.9",
    "@typechain/hardhat": "^9.1.0",
    "@types/fs-extra": "^11.0.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "forge-std": "github:foundry-rs/forge-std#v1.9.5",
    "fs-extra": "^11.3.0",
    "hardhat": "^2.22.19",
    "hardhat-deploy": "^1.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-solidity": "^1.4.2",
    "solhint": "^5.1.0",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-bytes-utils": "^0.8.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@layerzerolabs/lz-evm-oapp-v2": "^3.0.74",
    "@openzeppelin/contracts": "^5.2.0",
    "@openzeppelin/contracts-upgradeable": "^5.2.0"
  }
}
